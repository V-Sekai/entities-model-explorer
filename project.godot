; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ModelExplorer"
run/main_scene="res://vsk_model_explorer/scene/ModelExplorer.tscn"
config/features=PackedStringArray("4.6", "Double Precision", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"
config/macos_native_icon="res://vsk_model_explorer/resource/icon/app_icon.icns"
config/windows_native_icon="res://vsk_model_explorer/resource/icon/app_icon.ico"

[autoload]

FdbServer="*res://vsk_model_explorer/core/FdbServer.gd"
GlobalSignal="*res://vsk_model_explorer/core/GlobalSignal.gd"
MeshExt="*res://vsk_model_explorer/core/MeshExt.gd"
MCP="*res://addons/vsekai_godot_mcp/mcp_runtime.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/extend_to_title=true
window/energy_saving/keep_screen_on=false

[editor_plugins]

enabled=PackedStringArray("res://addons/Godot-MToon-Shader/plugin.cfg", "res://addons/vrm/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true
theme/default_theme_scale=1.2

[input]

toggle_wireframe={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":76,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
close_popup={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
explode_meshes={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":69,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
toggle_grid={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":71,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
toggle_xray={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":88,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

oit/enabled=true
oit/tile_size=Vector2i(4, 4)
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/use_physical_light_units=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_3d=2
scaling_3d/scale=0.8
anti_aliasing/quality/screen_space_aa=1

[vsekai_godot_mcp]

allow=PackedStringArray("ping", "get_scene_tree", "get_node", "get_property", "find_nodes", "get_aabb", "get_bone_poses")
providers=PackedStringArray("res://vsk_model_explorer/core/RigTools.gd")
server_name="skintokens-auto-rig"
server_title="SkinTokens auto-rig"
instructions="Open a model with load_model, rig it with auto_rig, then take the .vrm or .rigged.glb with get_file. screenshot shows the viewer. The scene tools only read."
listen_by_default=false
